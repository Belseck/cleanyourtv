<?xml version="1.0" encoding="utf-8"?>
<!-- Quick panel, opened by the remote's Settings button (settings_key_panel) or by holding Home where the
     system has no panel of its own: a full-height sheet at the edge, like Android TV's dashboard, over a
     scrim that darkens only that side. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:background="@drawable/qs_panel_bg"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp"
        android:elevation="16dp">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp"
            android:fontFamily="@string/font_light"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_regular" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
